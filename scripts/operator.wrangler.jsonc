{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-primitives-local-operator",
  "main": "operator.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "PAYMENT_STATE", "class_name": "PaymentState", "script_name": "agent-primitives", "remote": true }]
  },
  "dev": { "ip": "127.0.0.1", "port": 8788 }
}
